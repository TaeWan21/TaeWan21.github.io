@article{kim2025cosmetic,
  abbr        = {JDCS},
  bibtex_show = {true},
  title       = {Feature-based Beauty Product Search System through Feature Extraction from Reviews},
  author      = {Kim, Taewan and others},
  journal     = {Journal of Digital Contents Society},
  volume      = {26},
  number      = {6},
  pages       = {1721--1730},
  year        = {2025},
  month       = jun,
  publisher   = {Korean Digital Contents Society},
  abstract    = {Korean cosmetic reviews contain rich, free-form descriptions of how a product actually feels and performs — texture, scent, suitability for specific skin types — but standard product search ignores most of this signal. We present a review-grounded search pipeline that fine-tunes KoBERT for aspect-level sentiment analysis on Korean cosmetic reviews, extracts product-level features (e.g., moisturizing, long-lasting, suitable for oily skin), and serves them through an Elasticsearch-backed retrieval engine. The system is deployed as a production service at revieweyes.ajb.kr.},
  html        = {https://revieweyes.ajb.kr/},
  selected    = {true},
  additional_info = {. Related patent: KR Application No. 10-2025-00178132.}
}

